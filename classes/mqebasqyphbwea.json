{
  "id": "mqebasqyphbwea",
  "name": "Workflow de Assinatura — Principal 🟢",
  "sectionLayout": "tabs",
  "defaultCanvasMode": "edit",
  "metadata": "Classe Workflow de Assinatura (Atlas). Abas: Geral e Signatários. Configura o roteiro de assinatura digital por tipo de processo. Execução técnica via envelope no repositório. Recusa cancela o envelope inteiro. Processos em andamento preservam a configuração original.",
  "sections": [
    {
      "id": "sec-wf-geral",
      "title": "Geral",
      "icon": "description"
    },
    {
      "id": "sec-wf-signatarios",
      "title": "Signatários",
      "icon": "account_tree"
    }
  ],
  "fields": [
    {
      "size": "large",
      "readOnly": false,
      "required": true,
      "multiple": false,
      "relevance": "identity",
      "id": "patlasv4proto-wf-nome",
      "label": "Nome",
      "type": "text",
      "sectionId": "sec-wf-geral",
      "spec": "Função: Nome do workflow (ex.: Assinatura de Proposta Padrão).\nRegra: Obrigatório. Identifica o modelo na lista de Enviar para assinatura."
    },
    {
      "size": "medium",
      "readOnly": false,
      "required": true,
      "multiple": false,
      "relevance": "highlight",
      "id": "patlasv4proto-wf-tipo-processo",
      "label": "Tipo de Processo",
      "type": "textOptions",
      "sectionId": "sec-wf-geral",
      "options": [
        "Proposta",
        "Contrato",
        "Ordem de Serviço",
        "Termo de Homologação",
        "RAER",
        "Demanda · Atendimento via contrato",
        "Orçamento"
      ],
      "spec": "Função: Tipo de processo ao qual este workflow se aplica.\nRegra: Um tipo por workflow. Em Enviar para assinatura só aparecem workflows ativos compatíveis com o tipo do processo."
    },
    {
      "size": "small",
      "readOnly": true,
      "required": true,
      "multiple": false,
      "relevance": "common",
      "id": "patlasv4proto-wf-versao",
      "label": "Versão",
      "type": "text",
      "sectionId": "sec-wf-geral",
      "options": [
        "Versão 1 — MTI",
        "Versão 1 — Parceiros",
        "Versão 1 — Clientes"
      ],
      "spec": "Função: Versão do workflow (referência à versão de processo ativa).\nRegra: Somente leitura. Não é campo numérico livre."
    },
    {
      "size": "small",
      "readOnly": false,
      "required": true,
      "multiple": false,
      "relevance": "highlight",
      "id": "patlasv4proto-wf-ativo",
      "label": "Ativo",
      "type": "boolean",
      "sectionId": "sec-wf-geral",
      "spec": "Função: Disponibiliza o workflow em Enviar para assinatura.\nRegra: Somente workflows ativos aparecem no envio. Inativar não altera envelopes já disparados.",
      "hidden": true
    },
    {
      "size": "large",
      "readOnly": false,
      "required": true,
      "multiple": true,
      "relevance": "highlight",
      "id": "patlasv4proto-wf-etapas",
      "label": "Etapas do Workflow",
      "type": "embeddedReference",
      "sectionId": "sec-wf-signatarios",
      "linkedFormId": "form-patlasv4-proto-workflow-etapa",
      "embeddedDisplay": "table",
      "embeddedRoot": false,
      "spec": "Função: Lista de etapas/signatários do workflow.\nRegra: Obrigatório ter ao menos uma etapa ativa. Cargo da etapa deve ter Pode assinar = Sim."
    }
  ],
