  "methods": [
    {
      "id": "meth-f3-orc-ass",
      "name": "Enviar para assinatura MTI",
      "icon": "draw",
      "kind": "destaque",
      "editSectionId": "sec-f3-orc-t0",
      "spec": "De Em elaboração. Quem: MTI. Só oferta proativa. Valida as abas 1 e 2. Bloqueia se a saúde for Crítico. Gera os signatários e o PDF. Vai para Em assinatura MTI."
    },
    {
      "id": "meth-f3-orc-dec",
      "name": "Registrar decisão",
      "icon": "rule",
      "kind": "destaque",
      "editSectionId": "sec-f3-orc-t3",
      "spec": "De Aguardando cliente. Quem: cliente. Só oferta proativa, para Solicitar ajuste ou Não autorizar. Valida a aba 4. Solicitar ajuste vai para Ajuste solicitado. Não autorizar vai para Não autorizado."
    },
    {
      "id": "meth-f3-orc-rev",
      "name": "Revisar orçamento",
      "icon": "edit_note",
      "kind": "destaque",
      "editSectionId": "sec-f3-orc-t1",
      "spec": "De Ajuste solicitado. Quem: MTI. Só oferta proativa. Gera nova versão (+0.1), zera assinaturas e decisão e volta para Em elaboração. Saúde Crítico continua bloqueando o novo envio para assinatura."
    },
    {
      "id": "meth-f3-orc-can",
      "name": "Cancelar",
      "icon": "cancel",
      "kind": "menu",
      "editSectionId": "sec-f3-orc-t0",
      "spec": "De Em elaboração, Em assinatura MTI, Aguardando cliente ou Ajuste solicitado. Quem: MTI, com motivo. Só oferta proativa. Vai para Cancelado."
    },
    {
      "id": "meth-f3-orc-assinar",
      "name": "Assinar",
      "icon": "ink_pen",
      "kind": "destaque",
      "editSectionId": "sec-f3-orc-t2",
      "spec": "De Em assinatura MTI. Só oferta proativa. Cada signatário assina a própria linha. Sem ordem e sem presidente. Com todas as assinaturas, vai sozinho para Aguardando cliente."
    },
    {
      "id": "meth-f3-orc-aut",
      "name": "Decidir Autorizar e assinar",
      "icon": "verified",
      "kind": "destaque",
      "editSectionId": "sec-f3-orc-t3",
      "spec": "De Aguardando cliente. Quem: cliente. Só oferta proativa, com decisão Autorizar. Gera os signatários da autorização (fiscal, gestor e PO). Com a última assinatura, vai para Autorizado e gera o instrumento do caminho."
    }
  ],
